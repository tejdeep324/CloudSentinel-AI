{
  "instance_id": "i-db-prod-mysql-01",
  "ami_id": "ami-legacy-mysql-57",
  "os": "RedHat Enterprise Linux 8",
  "network": {
    "vpc_id": "vpc-migration-db",
    "subnet_id": "subnet-db-stage",
    "open_ports": [3306],
    "public_ip_assigned": true,
    "security_group_rules": [
      { "port": 3306, "source": "0.0.0.0/0", "protocol": "tcp", "status": "EXPOSED" }
    ]
  },
  "storage": {
    "volume_id": "vol-db-storage-data",
    "encrypted": false,
    "kms_key_id": null
  },
  "iam": {
    "attached_role": "RDSAccessRole",
    "least_privilege_compliant": false
  },
  "os_security": {
    "root_login_enabled": false,
    "password_auth_enabled": true,
    "cis_benchmark_compliant": false
  }
}